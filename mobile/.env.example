# --------------------------------------------------
# DCRUSTverse Mobile App Environment Configuration
# NOTE: In Expo, all client-facing variables must start with EXPO_PUBLIC_
# --------------------------------------------------

# Base REST API URL of your DCRUSTverse backend
# For local physical devices: http://<YOUR_LAN_IP>:4000/api/v1 (e.g. http://192.168.1.5:4000/api/v1)
# For Android emulator: http://10.0.2.2:4000/api/v1
# For production: https://api.dcrustverse.edu/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000/api/v1

# Supabase Auth Project URL
EXPO_PUBLIC_SUPABASE_URL=https://ufzkmcxsenybgnxaalra.supabase.co

# Supabase Client Publishable / Anon Key (Safe for mobile clients)
# DO NOT put service_role secret keys in mobile apps!
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bvapyWSp-WrGIA9O6bh4jg_Ut9dLryd
