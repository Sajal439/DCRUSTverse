{
  "name": "@dcrustverse/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/database/migrate.js",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "typescript": "7.0.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
