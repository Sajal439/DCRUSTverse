NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Exact frontend origin permitted to call this API from a browser.
CORS_ORIGIN=http://localhost:3000
# Supply a dedicated PostgreSQL database. For remote production connections use sslmode=verify-full.
# DATABASE_URL=postgresql://dcrustverse:YOUR_PASSWORD@localhost:5432/dcrustverse
DATABASE_POOL_SIZE=10
# Optional direct/session connection for migrations when the API uses a transaction pooler.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Set both values from the same Supabase project.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
