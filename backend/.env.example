# --------------------------------------------------
# Server & Network Configuration
# --------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Exact frontend origin permitted to call the backend (no trailing slash)
CORS_ORIGIN=http://localhost:3000

# --------------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------------
# Full PostgreSQL connection URL (e.g., Supabase, Neon, or local Postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Maximum connections in the API connection pool (default: 10)
DATABASE_POOL_SIZE=10

# (Optional) Direct session connection string if DATABASE_URL uses a transaction pooler (port 6543)
# DATABASE_MIGRATION_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --------------------------------------------------
# Supabase Auth & Identity
# --------------------------------------------------
# Both must be configured together from your Supabase Dashboard
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...